# NexAlert Backend Configuration
# Copy to .env and configure for your environment

# Database
DATABASE_URL=postgresql+asyncpg://nexalert:nexalert@localhost:5432/nexalert_dev

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=Nexalert/telemetry/node1
MQTT_CLIENT_ID=nexalert-backend
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_RECONNECT_DELAY_S=5

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Logging
LOG_LEVEL=INFO

# Telemetry Schema
TELEMETRY_SCHEMA_PATH=../../schemas/telemetry-envelope.schema.json
